{
  "name": "studyos-backend",
  "version": "1.0.0",
  "description": "StudyOS Backend REST API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:dev": "npx dotenv-cli -e .env.development -- tsx watch src/server.ts",
    "dev:prod": "npx dotenv-cli -e .env.production -- tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "build:dev": "npx dotenv-cli -e .env.development -- prisma generate && tsc",
    "build:prod": "npx dotenv-cli -e .env.production -- prisma generate && tsc",
    "start": "node dist/server.js",
    "start:dev": "npx dotenv-cli -e .env.development -- node dist/server.js",
    "start:prod": "npx dotenv-cli -e .env.production -- node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:dev": "npx dotenv-cli -e .env.development -- tsx prisma/seed.ts",
    "seed:prod": "npx dotenv-cli -e .env.production -- tsx prisma/seed.ts",
    "db:push:dev": "npx dotenv-cli -e .env.development -- prisma db push",
    "db:push:prod": "npx dotenv-cli -e .env.production -- prisma db push --skip-seed",
    "test": "jest --detectOpenHandles --passWithNoTests"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.4",
    "@types/swagger-ui-express": "^4.1.6",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.4",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.19.1",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  }
}
