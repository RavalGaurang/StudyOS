{
  "name": "studyos-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:dev": "npx dotenv-cli -e .env.development -- next dev -p 3000",
    "dev:prod": "npx dotenv-cli -e .env.production -- next dev -p 3000",
    "build": "next build",
    "build:dev": "npx dotenv-cli -e .env.development -- next build",
    "build:prod": "npx dotenv-cli -e .env.production -- next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.4",
    "lucide-react": "^0.439.0",
    "next": "^14.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-redux": "^9.1.2",
    "react-select": "^5.10.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "5.9.3"
  }
}
