generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SessionType {
  POMODORO_25_5
  POMODORO_50_10
  CUSTOM
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum GoalMetric {
  STUDY_HOURS
  TASKS_COMPLETED
  EXAM_SCORE
  ATTENDANCE_PERCENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum NotificationType {
  ASSIGNMENT_DUE
  EXAM_APPROACHING
  STUDY_REMINDER
  ATTENDANCE_WARNING
  GOAL_REMINDER
  TASK_REMINDER
  SYSTEM
}

enum AiRole {
  user
  assistant
  system
}

// --------------------------------------------------------
// USER & PROFILES
// --------------------------------------------------------

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(STUDENT)
  firstName       String
  lastName        String
  avatarUrl       String?
  isActive        Boolean          @default(true)
  isEmailVerified Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  studentProfile  StudentProfile?
  parentProfile   ParentProfile?
  teacherProfile  TeacherProfile?
  adminProfile    AdminProfile?

  refreshTokens   RefreshToken[]
  notifications   Notification[]
  aiConversations AiConversation[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model StudentProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  gradeLevel      String?
  targetGpa       Float?
  schoolName      String?
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinks     ParentStudent[]
  subjects        Subject[]
  tasks           Task[]
  assignments     Assignment[]
  exams           Exam[]
  attendance      Attendance[]
  notes           Note[]
  timetableEvents TimetableEvent[]
  studySessions   StudySession[]
  studyPlans      StudyPlan[]
  goals           Goal[]
  flashcardDecks  FlashcardDeck[]
  quizzes         Quiz[]
  quizAttempts    QuizAttempt[]

  @@index([userId])
}

model ParentProfile {
  id           String          @id @default(uuid())
  userId       String          @unique
  phoneNumber  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks ParentStudent[]

  @@index([userId])
}

model TeacherProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  department String?
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  permissions String[] @default(["ALL"])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ParentStudent {
  id           String         @id @default(uuid())
  parentId     String
  studentId    String
  relationship String         @default("Parent") // Mother, Father, Guardian
  isApproved   Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  parent       ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

// --------------------------------------------------------
// ACADEMIC HIERARCHY
// --------------------------------------------------------

model Subject {
  id              String           @id @default(uuid())
  studentId       String
  name            String
  code            String?
  color           String           @default("#3B82F6") // Hex color
  icon            String           @default("book")
  targetGrade     String?          // A, 90%, etc.
  creditHours     Int?             @default(3)
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student         StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  units           Unit[]
  tasks           Task[]
  assignments     Assignment[]
  exams           Exam[]
  attendance      Attendance[]
  notes           Note[]
  timetableEvents TimetableEvent[]
  studySessions   StudySession[]
  flashcardDecks  FlashcardDeck[]
  quizzes         Quiz[]
  studyPlanItems  StudyPlanItem[]

  @@index([studentId])
  @@index([studentId, isArchived])
}

model Unit {
  id             String          @id @default(uuid())
  subjectId      String
  title          String
  orderIndex     Int             @default(0)
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics         Topic[]
  notes          Note[]
  studyPlanItems StudyPlanItem[]

  @@index([subjectId])
}

model Topic {
  id             String          @id @default(uuid())
  unitId         String
  title          String
  orderIndex     Int             @default(0)
  isCompleted    Boolean         @default(false)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  notes          Note[]
  studySessions  StudySession[]
  studyPlanItems StudyPlanItem[]

  @@index([unitId])
}

// --------------------------------------------------------
// PRODUCTIVITY & SCHEDULE
// --------------------------------------------------------

model Task {
  id          String         @id @default(uuid())
  studentId   String
  subjectId   String?
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority   @default(MEDIUM)
  status      TaskStatus     @default(TODO)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([studentId, status])
  @@index([studentId, dueDate])
  @@index([subjectId])
}

model Assignment {
  id              String           @id @default(uuid())
  studentId       String
  subjectId       String
  title           String
  description     String?
  dueDate         DateTime
  status          AssignmentStatus @default(PENDING)
  maxMarks        Float?           @default(100)
  obtainedMarks   Float?
  submissionNotes String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student         StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, dueDate])
  @@index([subjectId])
}

model Exam {
  id               String         @id @default(uuid())
  studentId        String
  subjectId        String
  title            String
  examDate         DateTime
  durationMinutes  Int?           @default(120)
  maxMarks         Float?         @default(100)
  obtainedMarks    Float?
  weightagePercent Float?
  roomLocation     String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, examDate])
  @@index([subjectId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  subjectId String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, date])
  @@index([studentId])
  @@index([studentId, subjectId])
  @@index([date])
}

model TimetableEvent {
  id         String         @id @default(uuid())
  studentId  String
  subjectId  String?
  title      String
  dayOfWeek  Int            // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String         // "09:00"
  endTime    String         // "10:30"
  room       String?
  location   String?
  color      String?        @default("#3B82F6")
  recurrence String?        @default("WEEKLY")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([studentId, dayOfWeek])
}

// --------------------------------------------------------
// STUDY & KNOWLEDGE
// --------------------------------------------------------

model Note {
  id         String         @id @default(uuid())
  studentId  String
  subjectId  String?
  unitId     String?
  topicId    String?
  title      String
  content    String         // Markdown text
  isPinned   Boolean        @default(false)
  isArchived Boolean        @default(false)
  tags       String[]       @default([])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  unit       Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topic      Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([studentId, isPinned])
  @@index([subjectId])
}

model StudySession {
  id              String         @id @default(uuid())
  studentId       String
  subjectId       String?
  topicId         String?
  sessionType     SessionType    @default(POMODORO_25_5)
  durationMinutes Int            @default(25)
  startedAt       DateTime
  endedAt         DateTime
  notes           String?
  createdAt       DateTime       @default(now())

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic           Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([studentId, startedAt])
  @@index([subjectId])
}

model StudyPlan {
  id          String          @id @default(uuid())
  studentId   String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  targetHours Float           @default(10)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  student     StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items       StudyPlanItem[]

  @@index([studentId])
}

model StudyPlanItem {
  id               String         @id @default(uuid())
  studyPlanId      String
  subjectId        String?
  unitId           String?
  topicId          String?
  plannedMinutes   Int            @default(60)
  completedMinutes Int            @default(0)
  targetDate       DateTime?
  isCompleted      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studyPlan        StudyPlan      @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject          Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  unit             Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topic            Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studyPlanId])
}

model Goal {
  id           String         @id @default(uuid())
  studentId    String
  title        String
  description  String?
  targetDate   DateTime
  metricType   GoalMetric     @default(STUDY_HOURS)
  targetValue  Float
  currentValue Float          @default(0)
  status       GoalStatus     @default(IN_PROGRESS)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// --------------------------------------------------------
// FLASHCARDS & QUIZZES
// --------------------------------------------------------

model FlashcardDeck {
  id          String         @id @default(uuid())
  studentId   String
  subjectId   String?
  title       String
  description String?
  isPublic    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  flashcards  Flashcard[]

  @@index([studentId])
  @@index([subjectId])
}

model Flashcard {
  id           String        @id @default(uuid())
  deckId       String
  front        String
  back         String
  masteryLevel Int           @default(1) // 1 to 5
  reviewCount  Int           @default(0)
  nextReviewAt DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  deck         FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
  @@index([nextReviewAt])
}

model Quiz {
  id              String         @id @default(uuid())
  studentId       String
  subjectId       String?
  title           String
  description     String?
  durationMinutes Int            @default(15)
  totalMarks      Float          @default(100)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions       QuizQuestion[]
  attempts        QuizAttempt[]

  @@index([studentId])
  @@index([subjectId])
}

model QuizQuestion {
  id           String        @id @default(uuid())
  quizId       String
  questionText String
  questionType QuestionType  @default(MULTIPLE_CHOICE)
  marks        Float         @default(1)
  explanation  String?
  orderIndex   Int           @default(0)
  createdAt    DateTime      @default(now())

  quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      QuizOption[]
  answers      QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id          String       @id @default(uuid())
  questionId  String
  optionText  String
  isCorrect   Boolean      @default(false)
  orderIndex  Int          @default(0)

  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id               String         @id @default(uuid())
  quizId           String
  studentId        String
  score            Float          @default(0)
  percentage       Float          @default(0)
  totalQuestions   Int            @default(0)
  correctAnswers   Int            @default(0)
  wrongAnswers     Int            @default(0)
  timeSpentSeconds Int            @default(0)
  startedAt        DateTime       @default(now())
  completedAt      DateTime?

  quiz             Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers          QuizAnswer[]

  @@index([quizId])
  @@index([studentId])
}

model QuizAnswer {
  id               String       @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answerText       String?
  isCorrect        Boolean      @default(false)
  marksAwarded     Float        @default(0)

  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([questionId])
}

// --------------------------------------------------------
// NOTIFICATIONS & AI
// --------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model AiConversation {
  id          String      @id @default(uuid())
  userId      String
  title       String
  contextType String?     // SUBJECT, NOTE, GENERAL
  contextId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           AiRole         @default(user)
  content        String
  tokenCount     Int?           @default(0)
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
