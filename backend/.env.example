# Environment
NODE_ENV=development
PORT=5000

# Database (PostgreSQL URL)
DATABASE_URL="postgresql://studyos_user:studyos_password@localhost:5432/studyos_db?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="studyos_jwt_access_super_secret_development_key_32charsmin"
JWT_REFRESH_SECRET="studyos_jwt_refresh_super_secret_development_key_32charsmin"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:3000"

# AI Provider Configuration (Mock / Pluggable OpenAI / Anthropic / Gemini)
AI_PROVIDER="mock"
AI_API_KEY=""
